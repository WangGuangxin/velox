include_guard(GLOBAL)

# Source filtering is applied after the native library target is defined.
# Store deferred arguments as global properties: function-local variables no
# longer exist when a deferred call executes at the end of the directory.
function(_velox_apply_filtered_pgo)
  get_property(prefixes GLOBAL PROPERTY _VELOX_FILTERED_PGO_PREFIXES)
  foreach(prefix IN LISTS prefixes)
    get_property(applied GLOBAL PROPERTY "_VELOX_PGO_${prefix}_APPLIED")
    if(applied)
      continue()
    endif()
    get_property(target GLOBAL PROPERTY "_VELOX_PGO_${prefix}_TARGET")
    get_property(sources GLOBAL PROPERTY "_VELOX_PGO_${prefix}_SOURCES")
    get_property(flags GLOBAL PROPERTY "_VELOX_PGO_${prefix}_FLAGS")
    get_property(ipo_sources GLOBAL PROPERTY "_VELOX_PGO_${prefix}_IPO_SOURCES")
    get_property(ipo_flags GLOBAL PROPERTY "_VELOX_PGO_${prefix}_IPO_FLAGS")
    if(NOT TARGET "${target}")
      message(FATAL_ERROR "Filtered ${prefix} PGO target does not exist: ${target}")
    endif()
    get_target_property(target_dir "${target}" SOURCE_DIR)
    get_target_property(target_sources "${target}" SOURCES)
    set(known_sources)
    foreach(source IN LISTS target_sources)
      if(NOT source MATCHES "^\\$<")
        get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${target_dir}")
        list(APPEND known_sources "${absolute}")
      endif()
    endforeach()
    set(all_sources ${sources} ${ipo_sources})
    list(REMOVE_DUPLICATES all_sources)
    foreach(source IN LISTS all_sources)
      if(NOT source IN_LIST known_sources)
        if(source IN_LIST sources)
          set(kind PGO)
        else()
          set(kind IPO)
        endif()
        message(FATAL_ERROR "Filtered ${kind} source is not compiled by ${target}: ${source}")
      endif()
      if(source IN_LIST sources)
        set_property(SOURCE "${source}" TARGET_DIRECTORY "${target}"
                     APPEND PROPERTY COMPILE_OPTIONS ${flags})
        message(STATUS "${prefix} PGO source: ${source}")
      endif()
      if(source IN_LIST ipo_sources)
        set_property(SOURCE "${source}" TARGET_DIRECTORY "${target}"
                     APPEND PROPERTY COMPILE_OPTIONS ${ipo_flags})
        message(STATUS "${prefix} IPO source: ${source}")
      endif()
    endforeach()
    set_property(GLOBAL PROPERTY "_VELOX_PGO_${prefix}_APPLIED" TRUE)
  endforeach()
endfunction()

function(velox_configure_pgo prefix)
  set(${prefix}_PGO_MODE "OFF" CACHE STRING "PGO phase: OFF, GENERATE or USE")
  set_property(CACHE ${prefix}_PGO_MODE PROPERTY STRINGS OFF GENERATE USE)
  set(${prefix}_PGO_PROFILE "" CACHE PATH "GCC profile directory or Clang merged profile file")
  set(${prefix}_PGO_SOURCES "" CACHE STRING "Optional project-relative source allowlist; empty selects all")
  set(${prefix}_PGO_TARGET "velox" CACHE STRING "Native library target for the PGO source allowlist")
  option(${prefix}_PGO_PARTIAL_TRAINING "Keep untrained GCC functions optimized for speed" ON)
  option(${prefix}_PGO_IPO "Enable GCC cross-source optimization on selected engine files" OFF)
  set(${prefix}_PGO_IPO_SOURCES "" CACHE STRING "IPO source allowlist; empty uses the PGO allowlist")
  set(${prefix}_PGO_IPO_JOBS "16" CACHE STRING "Maximum GCC link-time optimization workers")
  string(TOUPPER "${${prefix}_PGO_MODE}" mode)
  if(NOT mode MATCHES "^(OFF|GENERATE|USE)$")
    message(FATAL_ERROR "${prefix}_PGO_MODE must be OFF, GENERATE or USE")
  endif()
  if(mode STREQUAL "OFF")
    if(${prefix}_PGO_IPO)
      message(FATAL_ERROR "${prefix}_PGO_IPO requires an active PGO phase")
    endif()
    return()
  endif()
  set(ipo_sources)
  set(ipo_flags)
  if(${prefix}_PGO_IPO)
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
      message(FATAL_ERROR "Source-filtered PGO IPO currently requires GCC")
    endif()
    if("${${prefix}_PGO_SOURCES}" STREQUAL "")
      message(FATAL_ERROR "Source-filtered IPO requires a PGO source allowlist")
    endif()
    if(NOT "${${prefix}_PGO_IPO_JOBS}" MATCHES "^[1-9][0-9]*$")
      message(FATAL_ERROR "${prefix}_PGO_IPO_JOBS must be a positive integer")
    endif()
    set(requested "${${prefix}_PGO_IPO_SOURCES}")
    if("${requested}" STREQUAL "")
      set(requested "${${prefix}_PGO_SOURCES}")
    endif()
    foreach(source IN LISTS requested)
      get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
      if(NOT EXISTS "${absolute}")
        message(FATAL_ERROR "Filtered IPO source does not exist: ${absolute}")
      endif()
      list(APPEND ipo_sources "${absolute}")
    endforeach()
    # Keep ordinary code in the objects for archive/tool compatibility. Retain
    # normal symbol binding while enabling optimization across these files.
    set(ipo_flags -flto -ffat-lto-objects)
    add_link_options("-flto=${${prefix}_PGO_IPO_JOBS}" -fuse-linker-plugin)
  endif()
  if("${${prefix}_PGO_PROFILE}" STREQUAL "")
    message(FATAL_ERROR "${prefix}_PGO_PROFILE is required for PGO ${mode}")
  endif()
  get_filename_component(profile "${${prefix}_PGO_PROFILE}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
  if(mode STREQUAL "GENERATE")
    file(MAKE_DIRECTORY "${profile}")
  elseif(NOT EXISTS "${profile}")
    message(FATAL_ERROR "PGO profile does not exist: ${profile}")
  endif()
  set(flags)
  if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    if(NOT IS_DIRECTORY "${profile}")
      message(FATAL_ERROR "GCC PGO requires a profile directory")
    endif()
    if(mode STREQUAL "GENERATE")
      set(flag "-fprofile-generate=${profile}")
      list(APPEND flags -fprofile-update=atomic)
    else()
      set(flag "-fprofile-use=${profile}")
      list(APPEND flags -fprofile-correction)
      if(${prefix}_PGO_PARTIAL_TRAINING)
        list(APPEND flags -fprofile-partial-training)
      endif()
    endif()
    list(APPEND flags "-fprofile-prefix-path=${CMAKE_BINARY_DIR}")
  elseif(CMAKE_CXX_COMPILER_ID MATCHES "^(Clang|AppleClang)$")
    if(mode STREQUAL "GENERATE")
      set(flag "-fprofile-instr-generate=${profile}/%m-%p.profraw")
    else()
      if(IS_DIRECTORY "${profile}")
        message(FATAL_ERROR "Clang PGO USE requires a merged llvm-profdata file")
      endif()
      set(flag "-fprofile-instr-use=${profile}")
    endif()
  else()
    message(FATAL_ERROR "PGO requires GCC or Clang")
  endif()
  list(APPEND flags "${flag}")
  if("${${prefix}_PGO_SOURCES}" STREQUAL "")
    add_compile_options(${flags})
  else()
    if(CMAKE_VERSION VERSION_LESS 3.19)
      message(FATAL_ERROR "Filtered PGO requires CMake 3.19 or newer")
    endif()
    set(sources)
    foreach(source IN LISTS ${prefix}_PGO_SOURCES)
      get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
      if(NOT EXISTS "${absolute}")
        message(FATAL_ERROR "Filtered PGO source does not exist: ${absolute}")
      endif()
      list(APPEND sources "${absolute}")
    endforeach()
    set_property(GLOBAL APPEND PROPERTY _VELOX_FILTERED_PGO_PREFIXES "${prefix}")
    set_property(GLOBAL PROPERTY "_VELOX_PGO_${prefix}_TARGET" "${${prefix}_PGO_TARGET}")
    set_property(GLOBAL PROPERTY "_VELOX_PGO_${prefix}_SOURCES" "${sources}")
    set_property(GLOBAL PROPERTY "_VELOX_PGO_${prefix}_FLAGS" "${flags}")
    set_property(GLOBAL PROPERTY "_VELOX_PGO_${prefix}_IPO_SOURCES" "${ipo_sources}")
    set_property(GLOBAL PROPERTY "_VELOX_PGO_${prefix}_IPO_FLAGS" "${ipo_flags}")
    cmake_language(DEFER CALL _velox_apply_filtered_pgo)
  endif()
  add_link_options("${flag}")
  message(STATUS "${prefix} PGO ${mode}: ${profile}")
endfunction()
